# BacLab - sizing and ports for docker/podman compose (read automatically from webserver/.env).
# Created by `./baclab install` from the machine it runs on; adjust to taste, then `./baclab restart`.
# Cores and memory the job worker container may use, and how many jobs run at the same time
WORKER_CPUS=@WORKER_CPUS@
WORKER_MEMORY=@WORKER_MEMORY@
CELERY_WORKER_CONCURRENCY=@CONCURRENCY@
# Ports nginx is published on (rootless podman cannot use ports below 1024: use e.g. 8080/8443)
HTTP_PORT=@HTTP_PORT@
HTTPS_PORT=@HTTPS_PORT@
# A second worker takes only quick jobs (MLST, fastp, ...) so they never wait behind heavy ones
LIGHT_WORKER_CPUS=2
LIGHT_WORKER_MEMORY=8GB
LIGHT_WORKER_CONCURRENCY=2
# Mount options of the data/databases folders. ",z" relabels them for SELinux (RHEL, Fedora, Rocky...) but is refused on network file
# systems (NFS, Lustre, GPFS): `./baclab install` detects that and writes the variants below without it.
# DATA_MODE=rw
# DB_MODE=ro
# DB_WRITE_MODE=rw
# DB_WORKER_MODE=rw
