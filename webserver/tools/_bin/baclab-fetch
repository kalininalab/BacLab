#!/usr/bin/env python3
"""baclab-fetch URL FILE - download a (big) file with retries and resume; used by the database installers.

Only the standard library, so it works in every container of the platform (no curl/wget needed).
"""
import os
import sys
import time
import urllib.error
import urllib.request


def fetch(url, target, attempts=6):
    for attempt in range(1, attempts + 1):
        try:
            done = os.path.getsize(target) if os.path.exists(target) else 0
            request = urllib.request.Request(url, headers={'Range': f'bytes={done}-'} if done else {'User-Agent': 'baclab-fetch'})
            with urllib.request.urlopen(request, timeout=60) as response:
                if done and response.status != 206:   # the server ignored the Range header: start over
                    done = 0
                total = response.headers.get('Content-Length')
                total = int(total) + done if total else None
                with open(target, 'ab' if done else 'wb') as out:
                    last = 0
                    while True:
                        chunk = response.read(1 << 20)
                        if not chunk:
                            break
                        out.write(chunk)
                        done += len(chunk)
                        if time.time() - last > 5:
                            last = time.time()
                            print(f'  {done / 1e6:,.0f} MB' + (f' of {total / 1e6:,.0f} MB' if total else ''), flush=True)
            if total and done < total:
                raise IOError(f'incomplete download ({done} of {total} bytes)')
            return
        except urllib.error.HTTPError as error:
            if error.code == 416 and os.path.exists(target):   # what is on disk is not a resumable partial file (e.g. a finished earlier run): start over
                os.remove(target)
            print(f'download attempt {attempt}/{attempts} failed: {error}', file=sys.stderr, flush=True)
            if attempt == attempts:
                raise SystemExit(f'Could not download {url}')
            time.sleep(min(30, 5 * attempt))
        except Exception as error:
            print(f'download attempt {attempt}/{attempts} failed: {error}', file=sys.stderr, flush=True)
            if attempt == attempts:
                raise SystemExit(f'Could not download {url}')
            time.sleep(min(30, 5 * attempt))


if __name__ == '__main__':
    if len(sys.argv) != 3:
        raise SystemExit(__doc__)
    fetch(sys.argv[1], sys.argv[2])
